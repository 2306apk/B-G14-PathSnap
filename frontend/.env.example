# PathSnap Frontend Environment Configuration
# Set this to your Mac backend machine's IP address and port (8000).

# Default local URL (if running on same machine)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Mode 1: Same Wi-Fi / Mobile Hotspot LAN Deployment
# Example: VITE_API_BASE_URL=http://192.168.1.50:8000

# Mode 2: ZeroTier Private Virtual Network Deployment
# Example: VITE_API_BASE_URL=http://10.147.19.120:8000

